# GEMINI_API_KEY: Required for Gemini AI API calls (Auto Emotion Tagging).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Required for official ElevenLabs Text-to-Speech and Voice Library API calls.
# Configure via server environment variables or AI Studio Secrets panel.
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
